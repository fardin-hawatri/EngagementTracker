# --- API (Render / local server) ---

# Instagram: mallika.some
INSTAGRAM_ACCESS_TOKEN=your_mallika_some_token_here

# Instagram: mallika.some.global
INSTAGRAM_ACCESS_TOKEN_GLOBAL=your_mallika_some_global_token_here

# Optional extra frontend origins. *.vercel.app and localhost are always allowed.
# CORS_ORIGINS=https://your-custom-domain.com

# Render sets PORT automatically. Local default is 8787.
# PORT=8787

# --- Frontend (Vercel / local Vite) ---
# Leave empty locally (Vite proxies /api -> 8787).
# On Vercel, set this to your Render API URL (no trailing slash).
VITE_API_URL=https://your-api.onrender.com

# --- Future: Facebook ---
# Add a facebook entry in server/config/profiles.ts and set e.g.:
# FACEBOOK_ACCESS_TOKEN=your_facebook_page_token_here
